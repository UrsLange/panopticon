# Copy to .env.local. Never commit credentials.
# Defaults keep both profile and operational data outside the application repository.
# PA_PROFILE_DIR=/absolute/path/to/your/profile-repository
# PA_DATA_DIR=/absolute/path/to/your/local-data
# PA_TIMEZONE=Europe/Berlin
# OPENAI_API_KEY=configure-locally
# PA_MODEL=your-model-id
# PA_MODEL_BASE_URL=https://litellm.jobrad.tech/v1
# PA_KEY_FILE defaults to ~/.config/jobrad-ai/litellm.key for the LiteLLM endpoint.
# PA_KEY_FILE=/absolute/path/to/token-file
# PA_CAPTURE_SHORTCUT=Command+Shift+Space
